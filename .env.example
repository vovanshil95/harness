# ============================================================
# Скопировать в .env и подставить реальные значения:
#   cp .env.example .env
# ============================================================

# --- Провайдер инференса ---------------------------------------------------
# Ключ DeepSeek. Имя переменной должно совпадать с provider из
# hermes-data/config.yaml: при provider=deepseek читается именно DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ключ Kimi / Moonshot.
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Обязателен: по умолчанию hermes идёт на api.moonshot.cn, который доступен
# не отовсюду. Международный эндпоинт — api.moonshot.ai.
KIMI_BASE_URL=https://api.moonshot.ai/v1

# --- Telegram --------------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Telegram user id, которым разрешено общаться с ботом (через запятую)
TELEGRAM_ALLOWED_USERS=000000000

# --- WebDAV (синхронизация Obsidian) ---------------------------------------
# Пароль сгенерировать: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
WEBDAV_USERNAME=obsidian
WEBDAV_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Второй пользователь ---------------------------------------------------
# Отдельный бот обязателен: один токен нельзя опрашивать двумя процессами,
# Telegram отдаёт 409 Conflict. Оставить пустым, если пользователь один.
TELEGRAM_BOT_TOKEN2=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_ALLOWED_USERS2=000000000
WEBDAV2_USERNAME=owner
WEBDAV2_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Третий пользователь ---------------------------------------------------
# Тоже отдельный бот: причина та же, один токен на два процесса не делится.
TELEGRAM_BOT_TOKEN3=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_ALLOWED_USERS3=000000000
WEBDAV3_USERNAME=guest
WEBDAV3_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Obsidian LiveSync ------------------------------------------------------
# Админ CouchDB: он же логин в настройках плагина Self-hosted LiveSync.
COUCHDB_USER=admin
COUCHDB_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx
# Ключ end-to-end шифрования волта. Задаётся в плагине на каждом устройстве
# вручную: при первом запуске плагин шифрует им свои настройки, и скопировать
# готовый data.json на другое устройство уже нельзя.
LIVESYNC_PASSPHRASE=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Логи ------------------------------------------------------------------
LOG_LEVEL=INFO
