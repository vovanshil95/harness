# ============================================================
# Скопировать в .env и подставить реальные значения:
#   cp .env.example .env
# ============================================================

# --- Провайдер инференса ---------------------------------------------------
# Ключ DeepSeek. Имя переменной должно совпадать с provider из
# hermes-data/config.yaml: при provider=deepseek читается именно DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram --------------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Telegram user id, которым разрешено общаться с ботом (через запятую)
TELEGRAM_ALLOWED_USERS=000000000

# --- Логи ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Legacy ----------------------------------------------------------------
# Раньше провайдер задавался этими переменными. Сейчас модель и эндпоинт
# берутся из hermes-data/config.yaml, а он перекрывает OPENAI_*.
# Оставлены для совместимости, для работы не требуются.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-pro
