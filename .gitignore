# Секреты — реальные значения только локально и на сервере
.env

# Данные агентов: сессии, авторизация, кеши, память.
# Содержат auth.json и токены — в репозиторий не попадают никогда.
hermes-data/

# Волты пользователей и состояние сервисов — данные, а не конфигурация.
webdav-data/
webdav-config/
couchdb-data/
couchdb-config/
vault/

# LiveSync-клиенты: локальная база PouchDB и settings.json с passphrase.
livesync-data/
livesync-*-data/

# Прочее
*.bak
*.log
*.tar.gz
.DS_Store

# Инструменты и результат добавления пользователей (содержат секреты)
tools/node_modules/
users/
